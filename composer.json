{
    "name": "builtforsmallbusiness/laravel-404-monitor",
    "description": "A 404 monitoring dashboard for Laravel with SEO and Googlebot tracking",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "404", "monitor", "seo", "googlebot", "missing-pages"],
    "authors": [
        {
            "name": "Josh Ade",
            "email": "hello@builtforsmallbusiness.com",
            "homepage": "https://builtforsmallbusiness.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "BuiltForSmallBusiness\\Laravel404Monitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BuiltForSmallBusiness\\Laravel404Monitor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BuiltForSmallBusiness\\Laravel404Monitor\\Laravel404MonitorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
